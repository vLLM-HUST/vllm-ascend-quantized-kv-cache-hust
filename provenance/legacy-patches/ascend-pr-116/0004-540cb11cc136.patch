@@ -1312,10 +1391,441 @@ class AscendAttentionBackendImpl(AttentionImpl):
             causal=attn_metadata.causal,
             output=output,
         )
+
+    def _repeat_kv(self, tensor: torch.Tensor) -> torch.Tensor:
+        if self.num_queries_per_kv == 1:
+            return tensor
+        return tensor.repeat_interleave(self.num_queries_per_kv, dim=1)
+
+    def _build_kivi_causal_mask(
+        self,
+        q_len: int,
+        kv_seq_len: int,
+        dtype: torch.dtype,
+        device: torch.device,
+    ) -> torch.Tensor:
+        q_pos = torch.arange(
+            kv_seq_len - q_len, kv_seq_len, dtype=torch.long, device=device
+        )
+        kv_pos = torch.arange(kv_seq_len, dtype=torch.long, device=device)
+        mask = kv_pos.unsqueeze(0) > q_pos.unsqueeze(1)
+        neg_inf = torch.finfo(dtype).min
+        return torch.where(
+            mask,
+            torch.full((), neg_inf, dtype=dtype, device=device),
+            torch.zeros((), dtype=dtype, device=device),
+        ).unsqueeze(0)
     
     def _unpack_int4(self, packed: torch.Tensor) -> torch.Tensor:
-        shifts = torch.arange(8, device=packed.device, dtype=torch.int32) * 4
-        return ((packed.to(torch.int32).unsqueeze(-1) >> shifts) & 0xF).to(torch.float32)
+        packed_i32 = packed.to(torch.int32)
+        lanes = [
+            ((packed_i32 >> (lane * 4)) & 0xF)
+            for lane in range(8)
+        ]
+        return torch.stack(lanes, dim=-1).to(torch.float32)
+
+    def _pack_int4(self, quant: torch.Tensor) -> torch.Tensor:
+        quant = quant.to(torch.int32)
+        packed = torch.zeros_like(quant[..., 0], dtype=torch.int32)
+        for lane in range(8):
+            packed = packed | (quant[..., lane] << (lane * 4))
+        return packed
+
+    def _check_kivi_cache_bound(self) -> None:
+        if (
+            self.k_quant_cache is None
+            or self.k_scale_cache is None
+            or self.k_mn_cache is None
+            or self.v_quant_cache is None
+            or self.v_scale_cache is None
+            or self.v_mn_cache is None
+        ):
+            raise RuntimeError("KIVI cache tensors are not bound.")
+
+    def _write_kivi_cache(
+        self,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        slot_mapping: torch.Tensor,
+    ) -> None:
+        if key is None or value is None or slot_mapping is None:
+            return
+
+        valid = slot_mapping >= 0
+        if not bool(valid.any()):
+            return
+
+        key = key[valid]
+        value = value[valid]
+        slots = slot_mapping[valid].to(torch.long)
+
+        for idx, slot in enumerate(slots.tolist()):
+            slot = int(slot)
+            self.kivi_residual_key_cache[slot] = key[idx].detach().clone()
+            self.kivi_residual_value_cache[slot] = value[idx].detach().clone()
+
+    def _append_kivi_step_slots(
+        self,
+        req_ids: list[str],
+        slot_mapping: torch.Tensor,
+        actual_seq_qlen: list[int],
+    ) -> None:
+        if not req_ids:
+            return
+
+        prev = 0
+        num_tokens = slot_mapping.shape[0]
+        for req_idx, req_id in enumerate(req_ids):
+            if req_idx >= len(actual_seq_qlen):
+                break
+            end = min(int(actual_seq_qlen[req_idx]), num_tokens)
+            end = max(end, prev)
+            req_slots = slot_mapping[prev:end]
+            prev = end
+
+            valid_slots = [int(slot) for slot in req_slots.tolist() if int(slot) >= 0]
+            if not valid_slots:
+                continue
+
+            self.kivi_key_residual_slots_by_req.setdefault(req_id, []).extend(valid_slots)
+            self.kivi_value_residual_slots_by_req.setdefault(req_id, []).extend(valid_slots)
+
+    def _get_kivi_ordered_slots(
+        self,
+        block_table: torch.Tensor,
+        seq_lens: list[int],
+    ) -> list[list[int]]:
+        self._check_kivi_cache_bound()
+        block_size = self.k_quant_cache.shape[-1] * 8
+        block_table = block_table.to(torch.long)
+        ordered_slots: list[list[int]] = []
+
+        for req_idx, seq_len in enumerate(seq_lens):
+            req_slots: list[int] = []
+            for pos in range(int(seq_len)):
+                block_pos = pos // block_size
+                block_offset = pos % block_size
+                block_id = int(block_table[req_idx, block_pos].item())
+                if block_id >= 0:
+                    req_slots.append(block_id * block_size + block_offset)
+            ordered_slots.append(req_slots)
+        return ordered_slots
+
+    def _is_aligned_kivi_key_window(self, window_slots: list[int]) -> bool:
+        if len(window_slots) != self.kivi_residual_length:
+            return False
+
+        block_size = self.k_quant_cache.shape[-1] * 8
+        group_size = self.kivi_group_size
+
+        for start in range(0, len(window_slots), group_size):
+            group_slots = window_slots[start:start + group_size]
+            if len(group_slots) != group_size:
+                return False
+
+            first_slot = int(group_slots[0])
+            last_slot = int(group_slots[-1])
+            block_idx = first_slot // block_size
+            block_offset = first_slot % block_size
+
+            if block_offset % group_size != 0:
+                return False
+            if last_slot // block_size != block_idx:
+                return False
+
+            expected = list(range(first_slot, first_slot + group_size))
+            if group_slots != expected:
+                return False
+
+        return True
+
+    def _flush_kivi_key_slots(self, slots: list[int]) -> None:
+        if not slots:
+            return
+
+        keys = []
+        for slot in slots:
+            key = self.kivi_residual_key_cache.get(slot)
+            if key is None:
+                raise RuntimeError(
+                    f"KIVI key residual tensor for slot {slot} is missing before flush."
+                )
+            keys.append(key)
+
+        slot_tensor = torch.tensor(
+            slots, dtype=torch.long, device=keys[0].device
+        )
+        self._write_kivi_key_quant_cache(torch.stack(keys, dim=0), slot_tensor)
+        for slot in slots:
+            self.kivi_residual_key_cache.pop(slot, None)
+
+    def _flush_kivi_value_slots(self, slots: list[int]) -> None:
+        if not slots:
+            return
+
+        values = []
+        for slot in slots:
+            value = self.kivi_residual_value_cache.get(slot)
+            if value is None:
+                raise RuntimeError(
+                    f"KIVI value residual tensor for slot {slot} is missing before flush."
+                )
+            values.append(value)
+
+        slot_tensor = torch.tensor(
+            slots, dtype=torch.long, device=values[0].device
+        )
+        self._write_kivi_value_quant_cache(torch.stack(values, dim=0), slot_tensor)
+        for slot in slots:
+            self.kivi_residual_value_cache.pop(slot, None)
+
+    def _flush_kivi_key_batches(self, window_slots: list[int]) -> None:
+        while len(window_slots) >= self.kivi_residual_length:
+            flush_slots = window_slots[:self.kivi_residual_length]
+            if not self._is_aligned_kivi_key_window(flush_slots):
+                break
+            self._flush_kivi_key_slots(flush_slots)
+            del window_slots[:self.kivi_residual_length]
+
+    def _flush_kivi_value_batches(self, window_slots: list[int]) -> None:
+        if len(window_slots) <= self.kivi_residual_length:
+            return
+
+        flush_slots = window_slots[:-self.kivi_residual_length]
+        self._flush_kivi_value_slots(flush_slots)
+        del window_slots[:-self.kivi_residual_length]
+
+    def _cleanup_dead_kivi_state(self, live_req_ids: set[str]) -> None:
+        for req_id in list(self.kivi_key_residual_slots_by_req.keys()):
+            if req_id not in live_req_ids:
+                self.kivi_key_residual_slots_by_req.pop(req_id, None)
+
+        for req_id in list(self.kivi_value_residual_slots_by_req.keys()):
+            if req_id not in live_req_ids:
+                self.kivi_value_residual_slots_by_req.pop(req_id, None)
+
+        for req_id in list(self.kivi_last_req_slots.keys()):
+            if req_id not in live_req_ids:
+                self.kivi_last_req_slots.pop(req_id, None)
+
+        managed_key_slots = {
+            slot
+            for slots in self.kivi_key_residual_slots_by_req.values()
+            for slot in slots
+        }
+        managed_value_slots = {
+            slot
+            for slots in self.kivi_value_residual_slots_by_req.values()
+            for slot in slots
+        }
+
+        for slot in list(self.kivi_residual_key_cache.keys()):
+            if slot not in managed_key_slots:
+                self.kivi_residual_key_cache.pop(slot, None)
+
+        for slot in list(self.kivi_residual_value_cache.keys()):
+            if slot not in managed_value_slots:
+                self.kivi_residual_value_cache.pop(slot, None)
+
+        for req_id in list(self.kivi_key_residual_slots_by_req.keys()):
+            if not self.kivi_key_residual_slots_by_req[req_id]:
+                self.kivi_key_residual_slots_by_req.pop(req_id, None)
+
+        for req_id in list(self.kivi_value_residual_slots_by_req.keys()):
+            if not self.kivi_value_residual_slots_by_req[req_id]:
+                self.kivi_value_residual_slots_by_req.pop(req_id, None)
+
+    def _sync_kivi_residual_windows(
+        self,
+        req_ids: list[str],
+        block_table: torch.Tensor,
+        seq_lens: list[int],
+    ) -> None:
+        ordered_slots = self._get_kivi_ordered_slots(block_table, seq_lens)
+        live_req_ids = set(req_ids)
+
+        for req_id, req_slots in zip(req_ids, ordered_slots):
+            req_slot_set = set(req_slots)
+            self.kivi_last_req_slots[req_id] = req_slots
+
+            key_window = self.kivi_key_residual_slots_by_req.setdefault(req_id, [])
+            value_window = self.kivi_value_residual_slots_by_req.setdefault(req_id, [])
+
+            key_window[:] = [
+                slot
+                for slot in key_window
+                if slot in req_slot_set and slot in self.kivi_residual_key_cache
+            ]
+            value_window[:] = [
+                slot
+                for slot in value_window
+                if slot in req_slot_set and slot in self.kivi_residual_value_cache
+            ]
+
+            self._flush_kivi_key_batches(key_window)
+            self._flush_kivi_value_batches(value_window)
+
+        self._cleanup_dead_kivi_state(live_req_ids)
+
+    def _write_kivi_key_quant_cache(
+        self,
+        key: torch.Tensor,
+        slot_mapping: torch.Tensor,
+    ) -> None:
+        self._check_kivi_cache_bound()
+        if key is None or slot_mapping is None:
+            return
+
+        valid = slot_mapping >= 0
+        if not bool(valid.any()):
+            return
+
+        key = key[valid].to(self.k_scale_cache.dtype)
+        slots = slot_mapping[valid].to(torch.long)
+
+        if key.shape[-1] != self.head_size:
+            raise RuntimeError(
+                "KIVI INT4 key head_size must match attention head_size "
+                f"({self.head_size}), got {key.shape[-1]}."
+            )
+
+        if self.head_size % 8 != 0:
+            raise RuntimeError(
+                f"KIVI INT4 int32 packing requires head_size ({self.head_size}) "
+                "to be divisible by 8."
+            )
+
+        block_size = self.k_quant_cache.shape[-1] * 8
+        if block_size % self.kivi_group_size != 0:
+            raise RuntimeError(
+                f"KIVI INT4 key cache requires block_size ({block_size}) to be "
+                f"divisible by kivi_group_size ({self.kivi_group_size})."
+            )
+
+        # Original KIVI semantics: once the FP residual window is full, quantize
+        # the flushed window directly from full-precision keys .
+        group_entries: dict[tuple[int, int], list[tuple[int, torch.Tensor]]] = {}
+        for idx, slot in enumerate(slots.tolist()):
+            block_idx = int(slot) // block_size
+            block_offset = int(slot) % block_size
+            group_idx = block_offset // self.kivi_group_size
+            group_entries.setdefault((block_idx, group_idx), []).append(
+                (block_offset, key[idx])
+            )
+
+        for (block_idx, group_idx), entries in group_entries.items():
+            if len(entries) != self.kivi_group_size:
+                raise RuntimeError(
+                    "KIVI key flush expects a full token group from the FP "
