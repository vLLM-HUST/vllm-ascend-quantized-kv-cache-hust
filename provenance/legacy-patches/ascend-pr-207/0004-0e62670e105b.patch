     @staticmethod
     def npu_dynamic_quant(
@@ -142,14 +174,31 @@ class BaseDeviceAdaptor:
         if use_mxfp_quant:
             raise RuntimeError("MXFP MoE quantization is only supported on Ascend A5.")
 
