+# AscendKVCacheFP8E4M3Method
+# ===========================================================================
+
+
+class TestAscendKVCacheFP8E4M3Method:
+
+    def test_create_weights_sets_fp8_dtype(self):
+        layer = _make_layer()
+        scheme = AscendKVCacheFP8E4M3Method()
+        scheme.create_weights(layer)
