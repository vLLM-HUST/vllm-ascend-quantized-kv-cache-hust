diff --git a/tests/ut/test_layered_prefill.py b/tests/ut/test_layered_prefill.py
index 8437fdb1ca..8ca9428fe1 100644
--- a/tests/ut/test_layered_prefill.py
+++ b/tests/ut/test_layered_prefill.py
